{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleDetection": "force",
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
